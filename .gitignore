__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
build/
dist/
*.egg-info/

# Runtime data lives in ~/.omnibots (OMNIBOTS_HOME), never in the repo.
# These catch accidental local homes used while testing.
.omnibots/
.omnibots-test*/

# The installer puts the code in ~/.omnibots itself, next to that data (like ~/.omni), so every name the app
# writes in its home stays out of git: never committed, never shown as a change, never touched by an update.
/backups/
/bots/
/db/
/forge/
/logs/
/profiles/
/project-history/
/projects/
/relays/
/sandbox/
/sessions/
/skills/
/settings.toml
/settings.json
/user_profile.md
/omnibots.lock
/update.log

# API keys and secrets dropped in the repo folder by hand
*apikey*
*api_key*
*.key
.env
.env.*

# local tooling (preview server config)
.claude/

# your local media (the app ships the small splash in omnibots/ui/assets/)
/Logo.png
/videos/
